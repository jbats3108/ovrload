{
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build && vite build --ssr",
        "build:ssr": "npm run build",
        "dev": "vite",
        "dev:lan": "LAN_DEV=1 vite",
        "sail:lan": "node --experimental-strip-types scripts/sail-lan.ts",
        "sail:localhost": "node --experimental-strip-types scripts/sail-lan.ts --localhost",
        "sail:up": "node --experimental-strip-types scripts/sail-up.ts",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "typecheck": "vue-tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui"
    },
    "devDependencies": {
        "@eslint/js": "^9.19.0",
        "@playwright/test": "^1.62.0",
        "@types/node": "^22.13.5",
        "@vitest/coverage-v8": "^3.2.7",
        "@vue/eslint-config-typescript": "^14.3.0",
        "@vue/test-utils": "^2.4.11",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-vue": "^9.32.0",
        "happy-dom": "^17.6.3",
        "prettier": "^3.4.2",
        "prettier-plugin-organize-imports": "^4.1.0",
        "prettier-plugin-tailwindcss": "^0.6.11",
        "typescript-eslint": "^8.23.0",
        "vite-plugin-pwa": "^1.3.0",
        "vite-plugin-vue-devtools": "^8.0.0",
        "vitest": "^3.2.7",
        "vue-tsc": "^2.2.4",
        "workbox-core": "^7.4.1",
        "workbox-precaching": "^7.4.1"
    },
    "dependencies": {
        "@inertiajs/vite": "^3.6.1",
        "@inertiajs/vue3": "^3.6.1",
        "@tailwindcss/vite": "^4.1.11",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vueuse/core": "^12.8.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "lucide-vue-next": "^0.468.0",
        "reka-ui": "^2.2.0",
        "tailwind-merge": "^3.2.0",
        "tailwindcss": "^4.1.1",
        "tw-animate-css": "^1.2.5",
        "typescript": "^5.2.2",
        "vite": "^7.0.4",
        "vue": "^3.5.40",
        "ziggy-js": "^2.4.2"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1"
    },
    "engines": {
        "node": ">=22 <23"
    },
    "volta": {
        "node": "22.23.1"
    }
}
