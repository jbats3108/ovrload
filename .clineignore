# .clineignore
#
# Paths Cline must not pull into context automatically (file listing, automatic
# context gathering, codebase search). Uses .gitignore pattern syntax:
#   dir/      directory          **/dir/   dir at any depth
#   *.ext     glob               /dir/    root-anchored only
#   !path     re-include        # line   comment
#
# This is a context/cost filter, NOT a security boundary: an explicit @ mention
# or a shell command can still reach an ignored path. To hard-block access,
# install the PreToolUse guard hook documented at
# https://docs.cline.bot/customization/clineignore
#
# Kept deliberately readable: app/ config/ database/ docs/ e2e/ resources/
# routes/ tests/ scripts/ vite/ AGENTS.md CONTEXT.md .clinerules/ .cursor/rules/
# .cline/skills/ public/images/guide/ (guide screenshots are required by
# .clinerules/tutorial-feature-docs.md).

# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
# 1.1G / 161M on a seeded checkout.
/node_modules/
**/node_modules/
/vendor/

# ---------------------------------------------------------------------------
# Lock files
# ---------------------------------------------------------------------------
# ~900K combined; composer.json / package.json stay readable.
/composer.lock
/package-lock.json

# ---------------------------------------------------------------------------
# Build output and generated frontend assets
# ---------------------------------------------------------------------------
/public/build/
/public/hot
/public/sw.js
/public/workbox-*.js
/bootstrap/ssr/
/bootstrap/cache/
# Generated by `php artisan ziggy:generate`.
/resources/js/ziggy.js

# ---------------------------------------------------------------------------
# Secrets and local environment
# ---------------------------------------------------------------------------
/.env
/.env.*
# Negation: the committed template stays readable.
!.env.example
/auth.json
/storage/*.key

# ---------------------------------------------------------------------------
# Runtime state
# ---------------------------------------------------------------------------
# storage/logs/laravel.log ~6M, storage/logs/browser.log ~3M. Use Cline's own
# log tools (read-log-entries / browser-logs) instead of reading the files.
/storage/
/.phpunit.cache/
/.phpunit.result.cache
/.phpactor.json

# ---------------------------------------------------------------------------
# Test and coverage artifacts
# ---------------------------------------------------------------------------
# 36M: HTML report, clover.xml, crap4j.xml, infection logs.
/coverage/
/test-results/
/playwright-report/

# ---------------------------------------------------------------------------
# Local databases
# ---------------------------------------------------------------------------
# Only used by the host (non-Sail) dev fallback.
*.sqlite
*.sqlite3

# ---------------------------------------------------------------------------
# Logs, editor and OS noise
# ---------------------------------------------------------------------------
*.log
/.idea/
/.nova/
/.fleet/
/.zed/
/.vscode/
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Re-include examples (uncomment as needed)
# ---------------------------------------------------------------------------
# Run `composer why` style dependency audits from the lock file:
# !/composer.lock
# !/package-lock.json
# Inspect a single CRAP-score page without loading the whole report:
# !/coverage/dashboard.html
