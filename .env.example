APP_NAME=OVRLOAD
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Sail (default local): ./vendor/bin/sail up -d
# Host-only fallback: SQLite + composer run dev (set DB_CONNECTION=sqlite, REDIS_HOST=127.0.0.1, MAIL_HOST=127.0.0.1, MAIL_PORT=2525)
APP_PORT=8000
FORWARD_DB_PORT=3306
FORWARD_REDIS_PORT=6379
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025
# Linux: if storage/bootstrap writes fail inside containers, set SUPERVISOR_PHP_USER=root
# SUPERVISOR_PHP_USER=root

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=43200 # 30 days (minutes)
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=ovrload_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=ovrload_cache_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=ovrload_database_

# Sail Mailpit: SMTP mailpit:1025, UI http://localhost:8025. Prod: smtp (Gmail interim) or resend + domain.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME=OVRLOAD
# Optional; invite Reply-To. Prod: admin@ovr-load.co.uk. Empty → inviting admin's email.
# MAIL_REPLY_TO_ADDRESS=admin@ovr-load.co.uk
# MAIL_REPLY_TO_NAME=OVRLOAD

# Resend (https://resend.com) — when MAIL_MAILER=resend + verified domain
# RESEND_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME=OVRLOAD
VITE_PORT=5173

# Laptop (default): `npm run sail:up` — localhost Vite HMR, APP_URL=http://localhost:8000.
# Phone on same Wi‑Fi: `npm run sail:up -- --lan` or `npm run sail:lan` (always re-detects LAN IP).
# Back to laptop-only: `npm run sail:localhost`. Manual override: `VITE_DEV_HOST=192.168.x.x npm run sail:lan`.
#
# Inertia SSR is off under Sail by default (config/inertia.php). Do not enable unless SSR is running.

# Invite-only registration. Empty = no master link (local). One-time links: Admin → Invites.
# Generate master secret: php artisan registration:invite-secret [--write]
# REGISTRATION_INVITE=
# REGISTRATION_INVITE_ROLE=admin

# Domain mailboxes (form notifications + contact). Requires Resend receiving on the domain.
OVRLOAD_ADMIN_MAILBOX=admin@ovr-load.co.uk
OVRLOAD_INVITE_MAILBOX=invite@ovr-load.co.uk
OVRLOAD_FEEDBACK_MAILBOX=feedback@ovr-load.co.uk
